{
    // Mutation testing is scoped to the critical files via --filter (see `make mutation`); the unit suite only,
    // because the e2e suite needs the compiled extension.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=unit",
    "logs": {
        "text": "build/infection/infection.log",
        "json": "build/infection/infection.json"
    },
    "mutators": {
        "@default": true
    }
}
